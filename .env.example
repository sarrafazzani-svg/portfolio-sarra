# Server Configuration
PORT=3001
NODE_ENV=production

# Security - CHANGE THIS TO A RANDOM STRING
SECRET_KEY=your-super-secret-key-change-this-in-production

# Email Configuration (Optional)
# Gmail requires an "App Password" - not your regular password
# Get it at: https://myaccount.google.com/apppasswords
GMAIL_USER=your-gmail@gmail.com
GMAIL_PASSWORD=your-app-password

# Note: For local development, you can set GMAIL_USER=disabled
# This will disable email sending but contact form will still work
